<!--
  agent-build-net: a conventional NAT network used ONLY while installing
  Omarchy or updating the base image. The Omarchy installer needs real
  internet access, which the sandbox network does not provide.

  This network is a hole in the sandbox by design. It is left defined but
  inactive, and manage-agent-vm.sh starts it only for the duration of a build
  or refresh, then stops it again. verify-isolation.sh fails if it is found
  running while the agent VM is on the sandbox network.
-->
<network>
  <name>agent-build-net</name>
  <forward mode='nat'>
    <nat>
      <port start='1024' end='65535'/>
    </nat>
  </forward>
  <bridge name='virbr-build' stp='on' delay='0'/>
  <mtu size='1500'/>
  <ip address='192.168.101.1' netmask='255.255.255.0'>
    <dhcp>
      <range start='192.168.101.10' end='192.168.101.99'/>
      <host mac='52:54:00:a9:e1:10' name='omarchy-agent' ip='192.168.101.10'/>
    </dhcp>
  </ip>
</network>
