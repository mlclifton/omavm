# Copy to /etc/omavm/credentials.env, then:
#   sudo chown root:omavm-proxy /etc/omavm/credentials.env
#   sudo chmod 0640 /etc/omavm/credentials.env
#
# These keys stay on the host. They are attached to outbound requests by the
# gateway and are never visible inside the guest.

ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
